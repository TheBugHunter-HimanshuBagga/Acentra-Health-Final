{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimshield.local/schemas/brief_output.v1.json",
  "title": "ClaimShield investigation brief (machine-readable)",
  "description": "Closed schema for an investigation brief. Producers: the deterministic template builder today, an LLM later. Consumer: the gateway validator, which is the only path from generated text to a user. Every sentence cites evidence-pack IDs; numbers are written as {{ID.key}} placeholders that the server fills from the pack numbers registry. Covers the seven official elements: evidence (summary), timeline (timeline_notes), network context (network_notes), confidence (confidence_statement), limitations, recommended human-review action (recommended_action + action_rationale), supporting case/risk context (case_context).",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "summary", "case_context", "timeline_notes", "network_notes", "precedent_notes",
               "confidence_statement", "hypothesis", "recommended_action", "action_rationale",
               "investigator_checklist", "what_would_change_my_mind", "limitations", "insufficient_evidence"],
  "properties": {
    "headline": { "$ref": "#/$defs/sentence" },
    "summary": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "case_context": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "timeline_notes": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/sentence" } },
    "network_notes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "precedent_notes": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "confidence_statement": { "$ref": "#/$defs/sentence" },
    "hypothesis": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,24}$" },
    "recommended_action": {
      "enum": ["REQUEST_RECORDS", "PROVIDER_EDUCATION", "MONITOR", "PREPAY_REVIEW_FLAG", "REFER_EXTERNAL"]
    },
    "action_rationale": { "$ref": "#/$defs/sentence" },
    "investigator_checklist": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "what_would_change_my_mind": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/sentence" } },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["text", "limitation_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 3, "maxLength": 600 },
          "limitation_ids": {
            "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^L[0-9]{1,3}$" }
          }
        }
      }
    },
    "insufficient_evidence": { "type": "boolean" }
  },
  "$defs": {
    "sentence": {
      "type": "object", "additionalProperties": false, "required": ["text", "evidence_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 3, "maxLength": 600 },
        "evidence_ids": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$" }
        }
      }
    }
  }
}

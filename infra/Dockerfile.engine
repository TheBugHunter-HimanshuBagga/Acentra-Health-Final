# Internal analytics engine. Base image tag unverified; confirm before the first build.
FROM python:3.12-slim
WORKDIR /app
COPY engine/requirements.txt engine/requirements.txt
RUN pip install --no-cache-dir -r engine/requirements.txt
COPY engine engine
COPY contracts contracts
WORKDIR /app/engine
ENV PYTHONPATH=/app/engine
# 0.0.0.0 is safe here only because compose exposes the port to the internal network, not the host.
CMD ["uvicorn", "claimshield.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

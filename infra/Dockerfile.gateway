# Builds the React app, embeds it in the Spring Boot jar (one origin, no CORS), runs on a Java 25 JRE.
# Base image tags are unverified; confirm they exist before the first build.
FROM node:24-slim AS web
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /app
COPY gateway/pom.xml gateway/pom.xml
COPY contracts contracts
COPY gateway/src gateway/src
COPY --from=web /app/web/dist gateway/src/main/resources/static
RUN mvn -q -f gateway/pom.xml -DskipTests package

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /app/gateway/target/gateway-*.jar app.jar
ENV APP_DB_PATH=/data/app.db
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

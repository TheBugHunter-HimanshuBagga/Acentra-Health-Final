# Copy to .env and fill in. NEVER commit .env. Only the Spring Boot gateway reads the API keys;
# the browser and the Python engine never see them.

# --- Claude (gateway only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BRIEF=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# live = call Claude; template = deterministic template briefs only (safe default for development)
LLM_MODE=template

# --- Sarvam (gateway only) ---
SARVAM_API_KEY=
VOICE_ENABLED=false

# --- App ---
# true enables the demo role switcher; MUST be false outside demos
DEMO_MODE=true

# --- Internal engine link (gateway to engine, loopback only) ---
ENGINE_URL=http://127.0.0.1:8000
ENGINE_TOKEN=dev-engine-token

# --- Shared SQLite file (relative paths resolve against the repo root) ---
APP_DB_PATH=data/app.db
